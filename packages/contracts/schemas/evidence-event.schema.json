{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dialback.dev/schemas/evidence-event.schema.json",
  "title": "EvidenceEvent",
  "description": "The envelope that audit.append_evidence() canonicalizes (RFC 8785) and hashes into the evidence chain. Built by app.apply_case_event() for every case state change. Owner: Abhi. Rules: numbers must be integers (amounts travel as integer cents or strings); the envelope never carries seq, prev_hash, hash or content_hash; no full bank account numbers, raw transcripts or recordings, only their last four, results and SHA-256 digests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "chain_id", "dataset_id", "case_id", "event_id", "type", "actor", "occurred_at", "idempotency_key", "from_state", "to_state", "version", "body"],
  "properties": {
    "v": { "const": 1, "description": "Envelope version." },
    "chain_id": { "$ref": "#/$defs/Uuid", "description": "The evidence chain this event belongs to (one per dataset)." },
    "dataset_id": { "$ref": "#/$defs/Uuid" },
    "case_id": { "$ref": "#/$defs/Uuid" },
    "event_id": { "$ref": "#/$defs/Uuid", "description": "Generated by the database; unique across chains." },
    "type": { "$ref": "#/$defs/EventType" },
    "actor": { "$ref": "#/$defs/Actor" },
    "occurred_at": {
      "type": "string",
      "description": "UTC, microsecond precision, as app.rfc3339() prints it.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 },
    "from_state": { "oneOf": [{ "$ref": "#/$defs/CaseState" }, { "type": "null" }], "description": "null for the event that opens a case." },
    "to_state": { "$ref": "#/$defs/CaseState" },
    "version": { "type": "integer", "minimum": 1, "description": "The case's change generation after this event." },
    "body": { "type": "object", "description": "Event-specific; see the per-type schemas below." }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "change_detected" } } },        "then": { "properties": { "body": { "$ref": "#/$defs/ChangeDetectedBody" } } } },
    { "if": { "properties": { "type": { "const": "hold_confirmed" } } },         "then": { "properties": { "body": { "$ref": "#/$defs/HoldConfirmedBody" } } } },
    { "if": { "properties": { "type": { "const": "hold_failed" } } },            "then": { "properties": { "body": { "$ref": "#/$defs/HoldFailedBody" } } } },
    { "if": { "properties": { "type": { "const": "number_resolved" } } },        "then": { "properties": { "body": { "$ref": "#/$defs/NumberResolvedBody" } } } },
    { "if": { "properties": { "type": { "const": "no_provable_number" } } },     "then": { "properties": { "body": { "$ref": "#/$defs/NoProvableNumberBody" } } } },
    { "if": { "properties": { "type": { "const": "call_started" } } },           "then": { "properties": { "body": { "$ref": "#/$defs/CallStartedBody" } } } },
    { "if": { "properties": { "type": { "const": "call_ended" } } },             "then": { "properties": { "body": { "$ref": "#/$defs/CallEndedBody" } } } },
    { "if": { "properties": { "type": { "const": "call_timeout" } } },           "then": { "properties": { "body": { "$ref": "#/$defs/CallTimeoutBody" } } } },
    { "if": { "properties": { "type": { "const": "retry_timer_fired" } } },      "then": { "properties": { "body": { "$ref": "#/$defs/RetryTimerFiredBody" } } } },
    { "if": { "properties": { "type": { "const": "decision_made" } } },          "then": { "properties": { "body": { "$ref": "#/$defs/DecisionMadeBody" } } } },
    { "if": { "properties": { "type": { "const": "review_cleared" } } },         "then": { "properties": { "body": { "$ref": "#/$defs/PersonActionBody" } } } },
    { "if": { "properties": { "type": { "const": "review_blocked" } } },         "then": { "properties": { "body": { "$ref": "#/$defs/PersonActionBody" } } } },
    { "if": { "properties": { "type": { "const": "release_co_approved" } } },    "then": { "properties": { "body": { "$ref": "#/$defs/PersonActionBody" } } } },
    { "if": { "properties": { "type": { "const": "release_approved" } } },       "then": { "properties": { "body": { "$ref": "#/$defs/PersonActionBody" } } } },
    { "if": { "properties": { "type": { "const": "release_rejected" } } },       "then": { "properties": { "body": { "$ref": "#/$defs/PersonActionBody" } } } },
    { "if": { "properties": { "type": { "const": "hold_release_confirmed" } } }, "then": { "properties": { "body": { "$ref": "#/$defs/HoldReleaseConfirmedBody" } } } },
    { "if": { "properties": { "type": { "const": "deadline_reached" } } },       "then": { "properties": { "body": { "$ref": "#/$defs/DeadlineReachedBody" } } } },
    { "if": { "properties": { "type": { "const": "command_failed" } } },         "then": { "properties": { "body": { "$ref": "#/$defs/CommandFailedBody" } } } }
  ],
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "IsoDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "CaseState": {
      "type": "string",
      "enum": ["open", "held", "calling", "retry_wait", "deciding", "awaiting_release", "needs_review", "blocked", "releasing", "released"]
    },
    "Outcome": { "type": "string", "enum": ["verified", "not_verified", "needs_review"] },
    "LastFourResult": {
      "description": "How the spoken digits compared with the case's accounts, computed in memory by packages/decision (tested in this order: inconsistent, ambiguous, match, matches_old_account, near_miss, mismatch; fewer than four digits, don't know or refused is not_provided). The digits themselves are never stored.",
      "type": "string",
      "enum": ["match", "matches_old_account", "near_miss", "mismatch", "not_provided", "ambiguous", "inconsistent"]
    },
    "EventType": {
      "type": "string",
      "enum": [
        "change_detected", "hold_confirmed", "hold_failed", "number_resolved", "no_provable_number",
        "call_started", "call_ended", "call_timeout", "retry_timer_fired", "decision_made",
        "review_cleared", "review_blocked", "release_co_approved", "release_approved", "release_rejected",
        "hold_release_confirmed", "deadline_reached", "command_failed"
      ]
    },
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "enum": ["system", "person"] },
        "id": { "oneOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }], "description": "auth user id for a person; null for the system." }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "person" } } }, "then": { "properties": { "id": { "$ref": "#/$defs/Uuid" } } } },
        { "if": { "properties": { "kind": { "const": "system" } } }, "then": { "properties": { "id": { "type": "null" } } } }
      ]
    },
    "ScheduleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bill_id", "payment_date"],
      "properties": {
        "bill_id": { "type": "string" },
        "payment_date": { "oneOf": [{ "$ref": "#/$defs/IsoDate" }, { "type": "null" }] }
      }
    },
    "ChangeDetectedBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_event_id"],
      "properties": {
        "change_event_id": { "$ref": "#/$defs/Uuid" },
        "policy_version": { "type": "string" },
        "detected_via": { "type": "string", "enum": ["webhook", "poll", "email"] },
        "source_event_id": { "type": "string" }
      }
    },
    "HoldConfirmedBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readback_ok"],
      "properties": {
        "readback_ok": { "const": true, "description": "The adapter read the vendor back and every unpaid bill shows the hold." },
        "ramp_ref": { "type": "string" },
        "placed_at": { "type": "string" },
        "bills_held": { "type": "integer", "minimum": 0 },
        "original_schedule": { "type": "array", "items": { "$ref": "#/$defs/ScheduleEntry" }, "description": "Saved before the hold, because a Ramp hold clears payment dates." }
      }
    },
    "HoldFailedBody": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempts": { "type": "integer", "minimum": 1 },
        "last_error": { "type": "string" }
      }
    },
    "NumberResolvedBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contact_point_id", "number_selection_id"],
      "properties": {
        "contact_point_id": { "$ref": "#/$defs/Uuid" },
        "number_selection_id": { "$ref": "#/$defs/Uuid", "description": "ledger.number_selections row: every candidate with its reason (Inesh's selection.schema.json)." },
        "rule_version": { "type": "string" },
        "source_types": { "type": "array", "items": { "type": "string" } }
      }
    },
    "NoProvableNumberBody": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "number_selection_id": { "$ref": "#/$defs/Uuid" },
        "rule_version": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "CallStartedBody": {
      "description": "The voice service accepted the call and returned its id. Pins the case's current call, so a report from an earlier generation's call is refused (spec 0002, D6).",
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "attempt"],
      "properties": {
        "call_id": { "$ref": "#/$defs/Uuid" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "CallEndedBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "result", "attempt"],
      "properties": {
        "call_id": { "$ref": "#/$defs/Uuid" },
        "result": { "type": "string", "enum": ["answers_recorded", "no_answer", "voicemail", "busy", "failed", "machine", "declined"] },
        "attempt": { "type": "integer", "minimum": 1 },
        "retry_at": { "type": "string" },
        "recording_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "transcript_sha256": { "$ref": "#/$defs/Sha256Hex" },
        "agent_version": { "type": "string" },
        "answers": {
          "$ref": "./call-answers.schema.json",
          "$comment": "Owned by Sami: the answer slots and allowed values shared by the voice tools, the text line and decide(). Code builds this from the agent's record_answer tool calls; the AI emits no events (I4). The stored shape: account digits only as a keyed hash."
        },
        "last_four_result": {
          "$ref": "#/$defs/LastFourResult",
          "description": "Computed by the core from the in-transit digits when the report arrives, before the digits are discarded (spec 0002, D7). Absent when no answers were recorded."
        },
        "contact_point_id": {
          "$ref": "#/$defs/Uuid",
          "description": "The Trust Ledger contact point that was dialed."
        },
        "checks": { "$ref": "#/$defs/CallChecks" }
      }
    },
    "CallChecks": {
      "description": "Computed by code in the voice service after the call, never by the model. Shared by the stored CallEndedBody and the core-voice report (openapi/internal.yaml). Checks that need case or ledger data (company match against the vendor's names, whether the speaker first appeared in the change thread) stay with the core.",
      "type": "object",
      "additionalProperties": false,
      "required": ["disclosure_first", "answers_grounded", "agent_spoke_account_digits", "new_number_accepted", "policy_violations", "speech_guard_trips"],
      "properties": {
        "disclosure_first": { "type": "boolean", "description": "The fixed AI and recording disclosure played in full as the first turn." },
        "answers_grounded": { "type": "boolean", "description": "Every recorded answer appears in the transcript turn it cites." },
        "agent_spoke_account_digits": { "type": "boolean", "description": "Must be false. True is a script violation." },
        "new_number_accepted": { "type": "boolean", "description": "Must be false. True is a script violation." },
        "policy_violations": { "type": "integer", "minimum": 0, "description": "Unknown tools or invalid tool arguments." },
        "speech_guard_trips": { "type": "integer", "minimum": 0 }
      }
    },
    "CallTimeoutBody": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "call_id": { "$ref": "#/$defs/Uuid" },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "RetryTimerFiredBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_window"],
      "properties": {
        "timer_id": { "type": "integer" },
        "in_window": { "type": "boolean" }
      }
    },
    "DecisionMadeBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "rules_fired", "inputs_hash", "engine_version"],
      "properties": {
        "outcome": { "$ref": "#/$defs/Outcome" },
        "rules_fired": { "type": "array", "items": { "type": "string" } },
        "inputs_hash": { "$ref": "#/$defs/Sha256Hex" },
        "engine_version": { "type": "string" },
        "strict_mode": { "type": "boolean" },
        "last_four_result": { "$ref": "#/$defs/LastFourResult" },
        "source": { "type": "string", "enum": ["call", "manual"] }
      }
    },
    "PersonActionBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "expected_version"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "expected_version": { "type": "integer", "minimum": 1 }
      }
    },
    "HoldReleaseConfirmedBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readback_ok"],
      "properties": {
        "readback_ok": { "const": true },
        "restored_schedule": { "type": "array", "items": { "$ref": "#/$defs/ScheduleEntry" } }
      }
    },
    "DeadlineReachedBody": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timer_id": { "type": "integer" },
        "deadline_at": { "type": "string" }
      }
    },
    "CommandFailedBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "attempts"],
      "properties": {
        "command": { "type": "string", "enum": ["place_hold", "select_number", "place_call", "decide", "release_hold", "notify"] },
        "attempts": { "type": "integer", "minimum": 1 },
        "last_error": { "type": "string" }
      }
    }
  }
}
