{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dialback.dev/schemas/run-result.schema.json",
  "title": "RunResult",
  "description": "One line of results.jsonl: one scenario variant run once through the real pipeline by the attack lab.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "scenario_id",
    "family_id",
    "class",
    "is_attack",
    "split",
    "epoch",
    "dataset_id",
    "decision",
    "final_state",
    "dialed_e164",
    "passed",
    "hard_failures",
    "failure_class"
  ],
  "properties": {
    "run_id": {
      "description": "The lab run (lab.lab_runs.id).",
      "$ref": "./evidence-event.schema.json#/$defs/Uuid"
    },
    "scenario_id": {
      "description": "family_id/variant_id",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}/[a-z0-9][a-z0-9-]{0,31}$"
    },
    "family_id": {
      "type": "string",
      "description": "Scenario family."
    },
    "class": {
      "type": "string",
      "description": "Attack or control class, from the scenario file."
    },
    "is_attack": {
      "type": "boolean",
      "description": "Copied from the scenario."
    },
    "split": {
      "enum": [
        "smoke",
        "dev",
        "held_out"
      ],
      "description": "Which scenario set this run belongs to."
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "description": "Repeat number when a set runs more than once."
    },
    "dataset_id": {
      "description": "The scenario's own dataset, so runs never share rows.",
      "$ref": "./evidence-event.schema.json#/$defs/Uuid"
    },
    "decision": {
      "description": "The decision engine's last outcome, or none if the case never reached deciding.",
      "oneOf": [
        {
          "$ref": "./evidence-event.schema.json#/$defs/Outcome"
        },
        {
          "const": "none"
        }
      ]
    },
    "final_state": {
      "description": "Case state after the release bot acted.",
      "$ref": "./evidence-event.schema.json#/$defs/CaseState"
    },
    "dialed_e164": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\+[1-9][0-9]{6,14}$"
      },
      "description": "Every number the voice service dialed for this case, in order."
    },
    "passed": {
      "type": "boolean",
      "description": "True if the run met every expected outcome for its variant."
    },
    "hard_failures": {
      "description": "Any entry blocks the merge.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "false_verified",
          "released_to_fraud",
          "dialed_fraudster_line",
          "script_violation",
          "chain_broken"
        ]
      }
    },
    "failure_class": {
      "description": "Primary reason the run failed, or null if it passed.",
      "enum": [
        null,
        "false_verified",
        "released_to_fraud",
        "dialed_fraudster_line",
        "script_violation",
        "chain_broken",
        "false_hold",
        "legit_sent_to_review",
        "missed_detection",
        "harness_error"
      ]
    },
    "time_to_decision_s": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Simulated seconds from the change to the decision."
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Model and telephony spend for this run."
    },
    "transcript_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Pointer to the redacted text-line transcript, if a call happened."
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000,
      "description": "Harness error message, if the run didn't complete."
    }
  }
}
