{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/core/Dockerfile",
    "watchPatterns": ["apps/core/**", "packages/decision/**", "packages/ledger/**", "supabase/migrations/**",
                      "scripts/db/migrate.py", "pyproject.toml", "uv.lock"]
  },
  "deploy": {
    "preDeployCommand": ["python scripts/db/migrate.py"],
    "startCommand": "dialback-core serve",
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
